node_modules/
dist/
# The client bundle is committed, because the GitHub Action runs it from this repository at a tag
# (packaging/github-action/notify.mjs); CI checks it matches a fresh build. The rest of the
# client's dist (tsc's types) is not.
!packages/client/dist/
packages/client/dist/*
!packages/client/dist/wim.mjs
coverage/
# The deployment kit copied in for a release (packaging/npm/agent-kit.mjs).
packaging/npm/agent-kit/
# vitest writes local reports here (the json reporter without --outputFile).
.vitest/
*.tsbuildinfo
.wrangler/
.dev.vars
*.db
*.db-journal
.DS_Store
