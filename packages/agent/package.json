{
  "name": "@worldinmotion/agent",
  "version": "0.2.1",
  "description": "wim agent: a worldinmotion peer that sleeps until an allowed device messages it, then runs one agent job through a runner command and replies",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sdk-runner": "./src/sdk-runner.ts",
    "./privileged": "./src/privileged.ts",
    "./kit": "./src/kit.ts"
  },
  "bin": {
    "wim-agent-runner": "./src/bin.ts",
    "wim-agent-privileged-runner": "./src/bin-privileged.ts"
  },
  "files": [
    "src",
    "README.md",
    "deploy",
    "docs"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "zod": "4.6.7",
    "@worldinmotion/protocol": "0.2.1"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@aws-sdk/client-sts": "3.1163.0",
    "@anthropic-ai/sdk": "1.6.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@aws-sdk/client-sts": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@anthropic-ai/sdk": "1.6.0",
    "@babel/runtime": "7.29.10",
    "@aws-sdk/client-sts": "3.1163.0"
  }
}
