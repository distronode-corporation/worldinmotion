{
  "v": 1,
  "worker": {
    "user": "wim-agent-worker",
    "home": "/var/lib/wim-agent-worker",
    "cwd": "/var/lib/wim-agent-worker/work",
    "additionalDirectories": ["/var/lib/wim-agent-worker/in"]
  },
  "runDir": "/run/wim-agent",
  "lock": { "path": "/run/wim-agent/job.lock", "waitSeconds": 900 },
  "minMemAvailableMb": 900,
  "timeoutSeconds": 900,
  "killGraceSeconds": 15,
  "maxTaskChars": 8000,
  "dailyJobs": 20,
  "statePath": "/var/lib/wim-agent-privileged/state.json",
  "allowDevices": ["REPLACE_WITH_DEVICE_ID", "REPLACE_WITH_DEVICE_I2"],
  "allowLocal": false,
  "wakeCode": { "file": "/etc/wim-agent/wake-code" },
  "defaultProfile": "main",
  "profiles": {
    "main": {
      "model": "claude-opus-5-5",
      "effort": "medium",
      "maxTurns": 20,
      "tools": ["Read", "Grep", "Glob"],
      "auth": { "type": "api-key", "keyFile": "/etc/wim-agent/anthropic-key" }
    }
  }
}
